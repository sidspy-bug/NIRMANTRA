# ──────────────────────────────────────────────
# Nirmantra AI — Environment Configuration
# Copy this file to .env and fill in the values.
# NEVER commit your .env file to version control.
# ──────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────
OPENAI_API_KEY=sk-your-key-here
# Optional: set OPENAI_BASE_URL if using OpenRouter (https://openrouter.ai/api/v1) or Ollama
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
NIRMANTRA_LLM_MODEL=gpt-4o
NIRMANTRA_EMBEDDING_MODEL=text-embedding-3-small

# ── OCR ───────────────────────────────────────
# Path to Tesseract binary (required for scanned document support)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example:   /usr/bin/tesseract
TESSERACT_CMD=tesseract

# ── Vector Store ──────────────────────────────
NIRMANTRA_CHROMA_PERSIST_DIR=./data/chroma_db
NIRMANTRA_CHROMA_COLLECTION=regulatory_docs

# ── Processing ────────────────────────────────
NIRMANTRA_MAX_PDF_PAGES=500
NIRMANTRA_OCR_LANGUAGES=eng+hin
NIRMANTRA_LOG_LEVEL=INFO

# ── API Server ────────────────────────────────
NIRMANTRA_API_HOST=127.0.0.1
NIRMANTRA_API_PORT=8000
