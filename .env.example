# NIRMAANTRA Platform Environment Configuration

# 1. FastAPI Central Backend (e.g. http://localhost:8000/api/v1)
# When unset, the application uses transparent in-memory/browser-state demonstration fixtures.
NEXT_PUBLIC_API_URL=

# 2. Teammate ML Microservice (e.g. http://localhost:8001/ml)
# When unset, the application displays "AI screening integration pending" and avoids fabricated scores.
NEXT_PUBLIC_ML_SERVICE_URL=

# 3. Mapbox GL Access Token (Optional)
# When unset, the platform provides a clean fallback view with data points and spatial coordinates.
NEXT_PUBLIC_MAPBOX_TOKEN=
